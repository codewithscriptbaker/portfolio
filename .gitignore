# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.swc/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
*.key
*.cert

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files (keep .env.example tracked)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS / tooling
*.log
.turbo
.cache

# generated seo files
public/sitemap.xml
public/robots.txt
